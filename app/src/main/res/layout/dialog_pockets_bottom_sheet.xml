<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Карман для бутылок"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Стандартная глубина кармана 110мм,
        высота передней полки 100мм(развёртка 120мм),к высоте кармана в развёртке прибавлено 10мм"
        android:textSize="14sp"
        android:textColor="@android:color/darker_gray"
        android:layout_marginBottom="18dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Количество карманов:"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginBottom="8dp" />

    <RadioGroup
        android:id="@+id/rgPocketCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/rbPocket0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:text="0 шт"
            android:textColor="@color/black"
            app:buttonTint="@color/black" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/rbPocket1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="1 шт"
            android:textColor="@color/black"
            app:buttonTint="@color/black" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/rbPocket2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="2 шт"
            android:textColor="@color/black"
            app:buttonTint="@color/black" />
    </RadioGroup>

    <TextView
        android:id="@+id/tvHeightLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Высота кармана:"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginBottom="8dp" />

    <RadioGroup
        android:id="@+id/rgPocketHeight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/rbHeight260"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:text="250 мм"
            android:textColor="@color/black"
            app:buttonTint="@color/black" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/rbHeight210"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="200 мм"
            android:textColor="@color/black"
            app:buttonTint="@color/black" />
    </RadioGroup>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnApplyPockets"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Применить"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold"
        app:cornerRadius="50dp" />

</LinearLayout>
